    "html": "<span class=\"color_41 wixui-rich-text__text\"><span style=\"font-size:27px;\" class=\"wixui-rich-text__text\">Countdown: Portfolio Campaign</span></span>",
    "text": "Countdown: Portfolio Campaign",
    "rect": {
     "x": 20,
