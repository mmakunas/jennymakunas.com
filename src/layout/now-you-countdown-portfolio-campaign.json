   {
    "kind": "text",
    "tag": "p",
    "html": "<span class=\"color_37 wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">How many instructors can you fit in one spot?&nbsp;</span></span>",
    "text": "How many instructors can you fit in one spot?",
    "rect": {
     "x": 20,
     "y": 339.6,
     "w": 280,
     "h": 50.4
    },
    "box": {
     "x": 20,
     "y": 339.6,
     "w": 280,
     "h": 403.3
    },
    "style": {
     "font": "cormorantgaramond-semibold",
     "size": 18,
     "weight": 400,
     "lineHeight": 25.2,
     "color": "rgb(160, 161, 173)",
     "align": "start",
     "spacing": null,
     "transform": "none",
     "decoration": "none",
     "style": "normal"
    },
    "href": null,
    "target": null
   },
   {
    "kind": "text",
    "tag": "p",
    "html": "<span class=\"color_37 wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Over half of MasterClass’s extensive portfolio of instructors are featured in this companion piece to the “Now You” brand campaign.&nbsp; The film was designed to showcase the depth and breadth of our instructor portfolio and get people thinking about the year to come with a sly nod to end-of-year countdowns and the growing excitement that a new year brings. The campaign launched just after Christmas with heavier media during New Year to capitalize on post-holiday sales and resolution setters.&nbsp;</span></span>",
    "text": "Over half of MasterClass’s extensive portfolio of instructors are featured in this companion piece to the “Now You” brand campaign.  The film was designed to showcase the depth and breadth of our instructor portfolio and get people thinking about the year to come with a sly nod to end-of-year countdowns and the growing excitement that a new year brings. The campaign launched just after Christmas with heavier media during New Year to capitalize on post-holiday sales and resolution setters.",
