    "html": "<span class=\"color_37 wixui-rich-text__text\"><span style=\"font-size:18px;\" class=\"wixui-rich-text__text\">Watch the episodes:&nbsp;<br class=\"wixui-rich-text__text\">\n<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ep. 1: </span><span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.youtube.com/watch?v=n35OUVcM4Tk\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"wixui-rich-text__text\">Meet Your Instructor</a></span> &nbsp;<br class=\"wixui-rich-text__text\">\n<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ep. 2: </span><span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.youtube.com/watch?v=-B0bctq7i7Q&amp;t=10s\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"wixui-rich-text__text\">Finding Your Assistant</a></span><br class=\"wixui-rich-text__text\">\n<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ep. 3: </span><span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.youtube.com/watch?v=9iA8YlUuNHQ&amp;t=11s\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"wixui-rich-text__text\">Disguises and the Art of Subterfuge</a></span> &nbsp;<br class=\"wixui-rich-text__text\">\n<span style=\"font-weight:bold;\" class=\"wixui-rich-text__text\">Ep. 4:</span> <span style=\"text-decoration:underline;\" class=\"wixui-rich-text__text\"><a href=\"https://www.youtube.com/watch?v=Iz8SoYBxriA\" target=\"_blank\" rel=\"noreferrer noopener\" class=\"wixui-rich-text__text\">Analyzing your Adversaries</a></span></span></span><br class=\"wixui-rich-text__text\">\n&nbsp;",
