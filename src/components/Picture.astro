---
// A still at the crop Wix gives its box: the desktop rendition, and the phone's
// own rendition where the phone box is a different shape.
import { url } from '../lib/url.js';
const { src, phone, alt, fit } = Astro.props;
---
<picture>
  {phone && <source media="(max-width: 749.9px)" srcset={url(phone)} />}
  <img src={url(src)} alt={alt || ''} loading="lazy" style={`object-fit:${fit || 'cover'}`} />
</picture>
