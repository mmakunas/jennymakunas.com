---
// The footer as Wix serves it: the Instagram and LinkedIn marks, the email and
// phone line, and the © line. Rendered from the capture so it lands at the same
// place on every page.
import { url } from '../lib/url.js';
const { footer } = Astro.props;
const height = `--footer-h:${footer.height}px`;
---
<footer class="site-footer" style={height}>
  {footer.blocks.map((b) =>
    b.kind === 'text' ? (
      <p class={`blk text ${b.cls}`} style={b.shared} set:html={b.html} />
    ) : b.src ? (
      <a class={`blk ${b.cls}`} style={b.shared} href={url(b.href || '#')} target={/^https?:/.test(b.href || '') ? '_blank' : undefined} rel="noopener">
        <img src={url(b.src)} alt={b.alt || ''} />
      </a>
    ) : null,
  )}
</footer>
