---
// The page body: absolutely placed blocks over a canvas whose height matches
// the captured page. Text reflows inside its captured box; images and video
// stills keep the captured box exactly. On the Work page the grid tiles are
// the captured gallery's, not block content.
import Block from './Block.astro';
import { url } from '../lib/url.js';

const { composed } = Astro.props;
const style = `--h-d:${composed.height}px;--h-m:${(composed.mobileHeight / 320) * 100}cqw`;
---
<div class="canvas" style={style}>
  {composed.blocks.map((b) => <Block block={b} />)}
  {(composed.tiles || []).map((t) => (
    <a class={`blk ${t.cls}`} href={url(t.href)}>
      <img src={url(t.src)} alt={t.alt} loading="lazy" style={`object-fit:${t.fit}`} />
    </a>
  ))}
</div>
