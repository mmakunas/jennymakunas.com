---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/url.js';

const { composed, css, chrome } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const current = composed.page.path.replace(/(.)\/$/, '$1');
// The address the page is published at: the deploy site plus the base path.
const canonical = `${import.meta.env.SITE.replace(/\/$/, '')}${base}${current}`;

const fontFaces = `
@font-face{font-family:'Cormorant Garamond';src:url('${base}/fonts/cormorant-garamond-1.woff2') format('woff2');font-weight:400;font-style:normal;font-display:swap}
@font-face{font-family:'Cormorant Garamond';src:url('${base}/fonts/cormorant-garamond-2.woff2') format('woff2');font-weight:700;font-style:normal;font-display:swap}
@font-face{font-family:'Jost';src:url('${base}/fonts/jost-latin.woff2') format('woff2');font-weight:400 700;font-style:normal;font-display:swap}
@font-face{font-family:'Jost';src:url('${base}/fonts/jost-latin-ext.woff2') format('woff2');font-weight:400 700;font-style:normal;font-display:swap}
@font-face{font-family:'Mulish';src:url('${base}/fonts/mulish-latin.woff2') format('woff2');font-weight:400 700;font-style:normal;font-display:swap}
@font-face{font-family:'Mulish';src:url('${base}/fonts/mulish-latin-ext.woff2') format('woff2');font-weight:400 700;font-style:normal;font-display:swap}
`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{composed.page.title} | Jenny Makunas</title>
    <link rel="icon" href={`${base}/favicon.ico`} />
    <link rel="canonical" href={canonical} />
    <style is:inline set:html={fontFaces} />
    <style is:inline set:html={chrome} />
    <style is:inline set:html={css} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to Main Content</a>
    <Header header={composed.header} current={current} />
    <main id="main">
      <slot />
    </main>
    <Footer footer={composed.footer} />
  </body>
</html>
